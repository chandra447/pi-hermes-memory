{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "paths": {
      "@gsd/pi-coding-agent": ["./node_modules/@earendil-works/pi-coding-agent"],
      "@gsd/pi-coding-agent/*": ["./node_modules/@earendil-works/pi-coding-agent/*"],
      "@gsd/pi-ai": ["./node_modules/@earendil-works/pi-ai"],
      "@gsd/pi-ai/*": ["./node_modules/@earendil-works/pi-ai/*"],
      "@gsd/pi-tui": ["./node_modules/@earendil-works/pi-tui"],
      "@gsd/pi-tui/*": ["./node_modules/@earendil-works/pi-tui/*"],
      "@gsd/pi-agent-core": ["./node_modules/@earendil-works/pi-agent-core"],
      "@gsd/pi-agent-core/*": ["./node_modules/@earendil-works/pi-agent-core/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
